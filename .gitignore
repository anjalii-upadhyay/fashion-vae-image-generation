# Data (downloaded at runtime, never committed)
data/*
!data/.gitkeep

# Generated outputs (plots are force-added selectively as they're reviewed;
# model weights are small for Fashion-MNIST so we track them directly to
# avoid retraining from scratch every session — revisit with Git LFS or
# GitHub Releases once DeepFashion makes checkpoints much larger)
outputs/*
!outputs/.gitkeep
!outputs/*.pt

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/

# OS
.DS_Store
